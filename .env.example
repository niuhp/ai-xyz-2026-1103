# 复制为 .env.local，填入本地密钥；不要提交 .env.local。
FASTAI_API_KEY=replace-with-your-key
FASTAI_BASE_URL=https://www.fastaitoken.com/v1
FASTAI_MODEL=deepseek-v4.1-flash
SERVER_PORT=8081

# 单次 SDK 调用超时；502/503 可额外重试一次，总耗时可能更长。
MODEL_TIMEOUT=15s
MODEL_MAX_RETRIES=1

# SSE 从接收到生成完成的本地总时限，流式不自动重试。
STREAM_TIMEOUT=45s

# 教学案例词项相似度阈值，不代表正确率。
KNOWLEDGE_THRESHOLD=0.16

# 第六篇：独立的向量服务，Base URL 包含 /v1，模型须支持 embeddings。
# FastAIToken 文档当前标注 embeddings 暂未开放，不能用聊天模型替代。
# 默认关闭；首次点击语义检索批量编码 16 条案例，重启后重建。
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_TIMEOUT=15s
EMBEDDING_THRESHOLD=0.55
# 是否需要前缀，以模型官方文档为准；需要时原样填写，包含空格。
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
